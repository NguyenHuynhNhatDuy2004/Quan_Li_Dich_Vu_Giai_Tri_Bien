<header class="main-header header-one white-menu menu-absolute">
    <div class="header-upper py-30 rpy-0">
        <div class="container-fluid clearfix">

            <div class="header-inner rel d-flex align-items-center">
                <div class="logo-outer">
                    <div class="logo">
                        <a asp-area="clients" asp-controller="Home" asp-action="Index">
                            <img src="~/clients/assets/images/logos/logo.png" alt="Logo" title="Logo">
                        </a>
                    </div>
                </div>

                <div class="nav-outer mx-lg-auto ps-xxl-5 clearfix">
                    <nav class="main-menu navbar-expand-lg">
                        <div class="navbar-header">
                            <div class="mobile-logo">
                                <a asp-area="clients" asp-controller="Home" asp-action="Index">
                                    <img src="~/clients/assets/images/logos/logo.png" alt="Logo" title="Logo">
                                </a>
                            </div>

                            <button type="button" class="navbar-toggle" data-bs-toggle="collapse"
                                    data-bs-target=".navbar-collapse">
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                        </div>

                        <div class="navbar-collapse collapse clearfix">
                            <ul class="navigation clearfix">
                                @* Kiểm tra active dựa trên Route Data *@
                                @{
                                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                                }

                                <li class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                                    <a asp-area="clients" asp-controller="Home" asp-action="Index">Trang chủ</a>
                                </li>
                                <li class="@(currentAction == "About" ? "active" : "")">
                                    <a asp-area="clients" asp-controller="Home" asp-action="About">Giới thiệu</a>
                                </li>
                                <li class="dropdown @(currentController == "Tour" ? "active" : "")">
                                    <a href="#">Tours</a>
                                    <ul>
                                        <li><a asp-area="clients" asp-controller="Tour" asp-action="Index">Tours</a></li>
                                        <li><a asp-area="clients" asp-controller="Tour" asp-action="Team">Hướng dẫn viên</a></li>
                                    </ul>
                                </li>

                                <li class="@(currentAction == "Destination" ? "active" : "")">
                                    <a asp-area="clients" asp-controller="Home" asp-action="Destination">Điểm đến</a>
                                </li>
                                <li class="@(currentAction == "Contact" ? "active" : "")">
                                    <a asp-area="clients" asp-controller="Home" asp-action="Contact">Liên Hệ</a>
                                </li>
                            </ul>
                        </div>

                    </nav>
                </div>

                <div class="nav-search">
                    <button class="far fa-search"></button>
                    <form asp-area="clients" asp-controller="Search" asp-action="VoiceText" class="hide" method="GET">
                        <input type="text" name="keyword" placeholder="Search" class="searchbox" required>
                        <i class="fa fa-microphone" aria-hidden="true" style="margin: 0 16px" id="voice-search"></i>
                        <button type="submit" class="searchbutton far fa-search"></button>
                    </form>
                </div>

                <div class="menu-btns py-10">
                    <a asp-area="clients" asp-controller="Tour" asp-action="Index" class="theme-btn style-two bgc-secondary">
                        <span data-hover="Đặt Ngay">Book Now</span>
                        <i class="fal fa-arrow-right"></i>
                    </a>

                    <div class="menu-sidebar">
                        <li class="drop-down">
                            <button class="dropdown-toggle bg-transparent" id="userDropdown" style="color: white">
                                @* Sử dụng Context.Session thay cho session() của Laravel *@
                                @if (Context.Session.GetString("avatar") != null)
                                {
                                    var avatar = Context.Session.GetString("avatar");
                                    <img id="avatarPreview" class="img-account-profile rounded-circle"
                                         src="~/admin/assets/images/user-profile/@avatar"
                                         style="width: 36px; height: 36px;">
                                }
                                else
                                {
                                    <i class='bx bxs-user bx-tada' style="font-size: 36px; color: white;"></i>
                                }
                            </button>

                            <ul class="dropdown-menu" id="dropdownMenu">
                                @if (Context.Session.GetString("username") != null)
                                {
                                    <li><a asp-area="clients" asp-controller="User" asp-action="Profile">Thông tin cá nhân</a></li>
                                    <li><a asp-area="clients" asp-controller="User" asp-action="MyTours">Tour đã đặt</a></li>
                                    <li><a asp-area="clients" asp-controller="Auth" asp-action="Logout">Đăng xuất</a></li>
                                }
                                else
                                {
                                    <li><a asp-area="clients" asp-controller="Auth" asp-action="Login">Đăng nhập</a></li>
                                }
                            </ul>
                        </li>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>