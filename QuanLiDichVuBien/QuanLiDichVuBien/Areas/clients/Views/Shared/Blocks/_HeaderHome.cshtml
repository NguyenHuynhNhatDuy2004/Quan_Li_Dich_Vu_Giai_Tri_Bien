@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<header class="main-header header-one white-menu menu-absolute">

    <!-- Header Upper -->
    <div class="header-upper py-30 rpy-0">
        <div class="container-fluid clearfix">

            <div class="header-inner rel d-flex align-items-center">

                <!-- Logo -->
                <div class="logo-outer">
                    <div class="logo">
                        <a asp-area="clients" asp-controller="Home" asp-action="Index">
                            <img src="~/clients/assets/images/logos/logo.png"
                                 alt="Logo"
                                 title="Logo">
                        </a>
                    </div>
                </div>

                <!-- Menu -->
                <div class="nav-outer mx-lg-auto ps-xxl-5 clearfix">

                    <nav class="main-menu navbar-expand-lg">

                        <div class="navbar-header">

                            <!-- Mobile Logo -->
                            <div class="mobile-logo">
                                <a asp-area="clients" asp-controller="Home" asp-action="Index">
                                    <img src="~/clients/assets/images/logos/logo.png"
                                         alt="Logo"
                                         title="Logo">
                                </a>
                            </div>

                            <!-- Toggle Button -->
                            <button type="button"
                                    class="navbar-toggle"
                                    data-bs-toggle="collapse"
                                    data-bs-target=".navbar-collapse">

                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                        </div>

                        <!-- Navbar Collapse -->
                        <div class="navbar-collapse collapse clearfix">

                            <ul class="navigation clearfix">

                                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                                    <a asp-area="clients"
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Trang chủ
                                    </a>
                                </li>

                                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "About" ? "active" : "")">
                                    <a asp-area="clients"
                                       asp-controller="About"
                                       asp-action="Index">
                                        Giới thiệu
                                    </a>
                                </li>

                                <li class="dropdown">
                                    <a href="#">Tours</a>

                                    <ul>
                                        <li>
                                            <a asp-area="clients"
                                               asp-controller="Tours"
                                               asp-action="Index">
                                                Tours
                                            </a>
                                        </li>

                                        <li>
                                            <a asp-area="clients"
                                               asp-controller="TravelGuides"
                                               asp-action="Index">
                                                Hướng dẫn viên
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Destination" ? "active" : "")">
                                    <a asp-area="clients"
                                       asp-controller="Destination"
                                       asp-action="Index">
                                        Điểm đến
                                    </a>
                                </li>

                                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contact" ? "active" : "")">
                                    <a asp-area="clients"
                                       asp-controller="Contact"
                                       asp-action="Index">
                                        Liên Hệ
                                    </a>
                                </li>

                                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Blog" ? "active" : "")">
                                    <a asp-area="clients"
                                       asp-controller="Blog"
                                       asp-action="Index">
                                        Blog
                                    </a>
                                </li>

                            </ul>

                        </div>

                    </nav>

                </div>

                <!-- Search -->
                <div class="nav-search">

                    <button class="far fa-search"></button>

                    <form asp-area="clients"
                          asp-controller="Search"
                          asp-action="Index"
                          method="get"
                          class="hide">

                        <input type="text"
                               name="keyword"
                               placeholder="Search"
                               class="searchbox"
                               required>

                        <button type="submit"
                                class="searchbutton far fa-search">
                        </button>

                    </form>

                </div>

                <!-- Right Menu -->
                <div class="menu-btns py-10 d-flex align-items-center">

                    <!-- Book Now -->
                    <a asp-area="clients"
                       asp-controller="Tours"
                       asp-action="Index"
                       class="theme-btn style-two bgc-secondary">

                        <span data-hover="Book Now">Book Now</span>
                        <i class="fal fa-arrow-right"></i>

                    </a>
                    <!-- CART -->
                    <div class="cart-box ms-3 me-2">

                        <a asp-area="clients"
                           asp-controller="Cart"
                           asp-action="Index"
                           class="cart-btn">

                            <i class="far fa-shopping-cart"></i>

                            <span class="cart-count">
                                2
                            </span>

                        </a>

                    </div>

                    <!-- User Dropdown -->
                    <div class="menu-sidebar ms-3">

                        <button id="userDropdown"
                                class="bg-transparent border-0">

                            <i class='bx bxs-user bx-tada'
                               style="font-size:36px; color:white;">
                            </i>

                        </button>

                        <ul class="dropdown-menu"
                            id="dropdownMenu">

                            @{
                                var username = HttpContextAccessor.HttpContext?.Session.GetString("username");
                            }
                            @if (!string.IsNullOrEmpty(username))
                            {
                                <li class="dropdown-user">
                                    @username
                                </li>

                                <li>
                                    <a asp-area="clients"
                                       asp-controller="UserProfile"
                                       asp-action="Index">
                                        Thông tin cá nhân
                                    </a>
                                </li>

                                <li>
                                    <a asp-area="clients"
                                       asp-controller="Login"
                                       asp-action="Logout">
                                        Đăng xuất
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-area="clients"
                                       asp-controller="Login"
                                       asp-action="Index">
                                        Đăng nhập
                                    </a>
                                </li>
                            }

                        </ul>

                    </div>

                </div>

            </div>

        </div>
    </div>

</header>