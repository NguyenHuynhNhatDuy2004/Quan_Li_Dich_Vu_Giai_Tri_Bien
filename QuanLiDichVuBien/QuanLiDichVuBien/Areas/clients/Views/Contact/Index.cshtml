@{
    Layout = "~/Areas/clients/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Về Chúng Tôi";
}


<partial name="~/Areas/clients/Views/Shared/Blocks/_BannerHome.cshtml" />

<!-- ABOUT -->
<section class="about-area-two py-100 rel z-1">
    <div class="container">

        <div class="row justify-content-between">

            <div class="col-xl-3"
                 data-aos="fade-right"
                 data-aos-duration="1500"
                 data-aos-offset="50">

                <span class="subtitle mb-35">
                    Về chúng tôi
                </span>
            </div>

            <div class="col-xl-9">

                <div class="about-page-content"
                     data-aos="fade-left"
                     data-aos-duration="1500"
                     data-aos-offset="50">

                    <div class="row">

                        <div class="col-lg-8 pe-lg-5 me-lg-5">

                            <div class="section-title mb-25">
                                <h2>
                                    Đơn vị cung cấp dịch vụ giải trí biển chuyên nghiệp tại Đà Nẵng
                                </h2>
                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="experience-years rmb-20">

                                <span class="title bgc-secondary">
                                    Năm kinh nghiệm
                                </span>

                                <span class="text">
                                    Chúng tôi có
                                </span>

                                <span class="years">5+</span>
                            </div>

                        </div>

                        <div class="col-md-8">

                            <p>
                                Travela chuyên cung cấp các hoạt động giải trí biển hiện đại và hấp dẫn
                                tại Đà Nẵng như Jetski, Flyboard, chèo SUP, tour cano,
                                lặn ngắm san hô và khám phá bán đảo Sơn Trà.
                                Chúng tôi mong muốn mang đến cho du khách những trải nghiệm
                                an toàn, chuyên nghiệp và đáng nhớ nhất.
                            </p>

                            <ul class="list-style-two mt-35">
                                <li>Dịch vụ giải trí biển chuyên nghiệp</li>
                                <li>Đội ngũ hướng dẫn tận tâm</li>
                                <li>Chi phí hợp lý</li>
                                <li>Hỗ trợ khách hàng 24/7</li>
                            </ul>

                            <a asp-area="clients"
                               asp-controller="Tours"
                               asp-action="Index"
                               class="theme-btn style-three mt-30">

                                <span data-hover="Khám phá Dịch vụ">
                                    Khám phá Dịch vụ
                                </span>

                                <i class="fal fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>

<!-- FEATURES -->
<section class="about-features-area">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-xl-4 col-md-6">
                <div class="about-feature-image"
                     data-aos="fade-up"
                     data-aos-duration="1500"
                     data-aos-offset="50">

                    <img src="~/clients/assets/images/about/about-feature1.jpg"
                         alt="About">
                </div>
            </div>

            <div class="col-xl-4 col-md-6">
                <div class="about-feature-image"
                     data-aos="fade-up"
                     data-aos-delay="50"
                     data-aos-duration="1500"
                     data-aos-offset="50">

                    <img src="~/clients/assets/images/about/about-feature2.jpg"
                         alt="About">
                </div>
            </div>

            <div class="col-xl-4 col-md-8">

                <div class="about-feature-boxes"
                     data-aos="fade-up"
                     data-aos-delay="100"
                     data-aos-duration="1500"
                     data-aos-offset="50">

                    <div class="feature-item style-three bgc-secondary">

                        <div class="icon-title">
                            <div class="icon">
                                <i class="flaticon-award-symbol"></i>
                            </div>

                            <h5>
                                <a href="#">
                                    Dịch vụ đạt tiêu chuẩn chất lượng cao
                                </a>
                            </h5>
                        </div>

                        <div class="content">
                            <p>
                                Chúng tôi luôn cam kết mang đến trải nghiệm
                                giải trí biển an toàn và chuyên nghiệp cho du khách.
                            </p>
                        </div>

                    </div>

                    <div class="feature-item style-three bgc-primary">

                        <div class="icon-title">
                            <div class="icon">
                                <i class="flaticon-tourism"></i>
                            </div>

                            <h5>
                                <a href="#">
                                    Hơn 50+ hoạt động biển hấp dẫn
                                </a>
                            </h5>
                        </div>

                        <div class="content">
                            <p>
                                Đa dạng dịch vụ giải trí biển phù hợp cho
                                cá nhân, nhóm bạn và gia đình.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="about-us-area pt-70 pb-100 rel z-1">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-xl-5 col-lg-6">

                <div class="about-us-content rmb-55"
                     data-aos="fade-left"
                     data-aos-duration="1500"
                     data-aos-offset="50">

                    <div class="section-title mb-25">
                        <h2>
                            Vì sao khách hàng lựa chọn dịch vụ của Travela
                        </h2>
                    </div>

                    <p>
                        Chúng tôi luôn đặt trải nghiệm khách hàng lên hàng đầu,
                        từ chất lượng dịch vụ, trang thiết bị hiện đại đến đội ngũ
                        hỗ trợ tận tình nhằm mang lại chuyến đi trọn vẹn nhất.
                    </p>

                    <div class="row pt-25">

                        <div class="col-6">
                            <div class="counter-item counter-text-wrap">

                                <span class="count-text k-plus"
                                      data-speed="2000"
                                      data-stop="1">0</span>

                                <span class="counter-title">
                                    Bãi biển nổi bật
                                </span>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="counter-item counter-text-wrap">

                                <span class="count-text m-plus"
                                      data-speed="3000"
                                      data-stop="8">0</span>

                                <span class="counter-title">
                                    Khách hàng hài lòng
                                </span>
                            </div>
                        </div>

                    </div>

                    <a href="#"
                       class="theme-btn mt-10 style-two">

                        <span data-hover="Khám phá Dịch vụ">
                            Khám phá Dịch vụ
                        </span>

                        <i class="fal fa-arrow-right"></i>
                    </a>

                </div>

            </div>

            <div class="col-xl-7 col-lg-6"
                 data-aos="fade-right"
                 data-aos-duration="1500"
                 data-aos-offset="50">

                <div class="about-us-page">

                    <img src="~/clients/assets/images/about/about-page.jpg"
                         alt="About">

                </div>

            </div>

        </div>

    </div>
</section>

