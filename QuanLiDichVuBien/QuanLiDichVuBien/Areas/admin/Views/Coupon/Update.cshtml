@* Areas/admin/Views/Coupon/Update.cshtml *@
@model QuanLiDichVuBien.Areas.admin.Models.CouponViewModel
@using QuanLiDichVuBien.Areas.admin.Models
@{
    ViewData["Title"] = "Cập nhật mã giảm giá";
}

<div class="page-header">
    <h3 class="fw-bold mb-3">Cập nhật mã giảm giá</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator"><i class="icon-arrow-right"></i></li>
        <li class="nav-item">
            <a asp-area="Admin" asp-controller="Coupon" asp-action="Index">Mã giảm giá</a>
        </li>
        <li class="separator"><i class="icon-arrow-right"></i></li>
        <li class="nav-item active">Cập nhật</li>
    </ul>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">
                    <i class="fas fa-edit me-2"></i>
                    Cập nhật mã: <span class="badge bg-secondary font-monospace">@Model.Code</span>
                </h4>
            </div>
            <div class="card-body">
                <form asp-area="Admin"
                      asp-controller="Coupon"
                      asp-action="Update"
                      method="post">
                    @Html.AntiForgeryToken()

                    {{! Hidden fields giữ lại dữ liệu không được chỉnh }}
                    <input type="hidden" asp-for="CouponID" />
                    <input type="hidden" asp-for="UsedCount" />
                    <input type="hidden" asp-for="CreateAt" />

                    <div class="row">

                        {{! Mã giảm giá - readonly khi edit }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="Code" class="form-label fw-bold"></label>
                            <input asp-for="Code"
                                   class="form-control text-uppercase font-monospace"
                                   readonly />
                            <small class="text-muted">Mã không thể thay đổi sau khi tạo</small>
                        </div>

                        {{! Loại giảm giá }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountType" class="form-label fw-bold"></label>
                            <select asp-for="DiscountType" class="form-select" id="discountTypeSelect">
                                <option value="0">Phần trăm (%)</option>
                                <option value="1">Số tiền (₫)</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger small"></span>
                        </div>

                        {{! Giá trị giảm }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountValue" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="DiscountValue"
                                       type="number"
                                       class="form-control"
                                       placeholder="0" />
                                <span class="input-group-text" id="discountUnit">%</span>
                            </div>
                            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                        </div>

                        {{! Giảm tối đa (chỉ hiện khi %) }}
                        <div class="col-md-6 mb-3" id="maxDiscountGroup">
                            <label asp-for="MaxDiscountAmount" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="MaxDiscountAmount"
                                       type="number"
                                       class="form-control"
                                       placeholder="Để trống = không giới hạn" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
                        </div>

                        {{! Đơn tối thiểu }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinOrderAmount" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="MinOrderAmount"
                                       type="number"
                                       class="form-control"
                                       placeholder="0" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
                        </div>

                        {{! Số lượng }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold"></label>
                            <input asp-for="Quantity"
                                   type="number"
                                   class="form-control" />
                            <small class="text-muted">Đã dùng: @Model.UsedCount lượt</small>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        {{! Ngày bắt đầu }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label fw-bold"></label>
                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control"
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        {{! Ngày kết thúc }}
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label fw-bold"></label>
                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control"
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        {{! Mô tả }}
                        <div class="col-md-12 mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Mô tả ngắn về mã giảm giá..."></textarea>
                        </div>

                        {{! Kích hoạt }}
                        <div class="col-md-12 mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch" />
                                <label asp-for="IsActive" class="form-check-label fw-bold">
                                    Kích hoạt mã
                                </label>
                            </div>
                        </div>

                        {{! Thông tin không chỉnh sửa được }}
                        <div class="col-md-12 mb-3">
                            <div class="alert alert-light border">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <small class="text-muted d-block">Ngày tạo</small>
                                        <strong>@Model.CreateAt.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Đã sử dụng</small>
                                        <strong>@Model.UsedCount / @Model.Quantity lượt</strong>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Trạng thái</small>
                                        @if (Model.IsExpired)
                                        {
                                            <span class="badge bg-secondary">Hết hạn</span>
                                        }
                                        else if (!Model.IsActive)
                                        {
                                            <span class="badge bg-danger">Đã tắt</span>
                                        }
                                        else if (Model.RemainingQuantity == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Hết lượt</span>
                                        }
                                        else if (Model.StartDate > DateTime.Now)
                                        {
                                            <span class="badge bg-info">Chưa bắt đầu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i>
                            Lưu cập nhật
                        </button>
                        <a asp-area="Admin"
                           asp-controller="Coupon"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="fa fa-arrow-left me-1"></i>
                            Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Script {
    <script>
        const typeSelect = document.getElementById('discountTypeSelect');
        const maxGroup   = document.getElementById('maxDiscountGroup');
        const unitSpan   = document.getElementById('discountUnit');

        function toggleDiscountType() {
            const isPercent = typeSelect.value === '0';
            maxGroup.style.display = isPercent ? 'block' : 'none';
            unitSpan.textContent   = isPercent ? '%' : '₫';
        }

        typeSelect.addEventListener('change', toggleDiscountType);
        toggleDiscountType(); // Chạy khi load để ẩn/hiện đúng theo giá trị hiện tại
    </script>
}